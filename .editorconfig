root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{md,json,yml,yaml}]
end_of_line = lf
indent_size = 2

# ABAP sources are formatted by ABAP Cleaner in ADT; the editor only
# needs to agree on the basics.
[*.abap]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
