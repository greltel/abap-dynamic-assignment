{
  "input_folder": "src",
  "input_filter": [
    "zda.msag",
    "ztda_variants.tabl",
    "ztda_variants_d.tabl",
    "zde_da_",
    "zdo_da_",
    "zif_da_variants.intf",
    "zif_da_repository.intf",
    "zif_da_value_check.intf",
    "zif_da_rule_matcher.intf",
    "zif_da_system_context.intf",
    "zif_da_authorization.intf",
    "zcx_da_variants.clas",
    "zcl_da_variants.clas",
    "zcl_da_repository.clas",
    "zcl_da_value_check.clas",
    "zcl_da_rule_matcher.clas",
    "zcl_da_system_context.clas",
    "zcl_da_authorization.clas"
  ],
  "output_folder": "output",
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/open-abap-rap"
    },
    {
      "url": "https://github.com/open-abap/open-abap-xco"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "runtimeError",
    "setup": {
      "filename": "../db_setup.mjs",
      "preFunction": "setupDatabase"
    },
    "skip": [
      {
        "object": "ZCL_DA_VARIANTS",
        "class": "LTC_VARIANTS",
        "method": "GIVEN_MAP_EL_THEN_TYPED",
        "note": "open-abap RTTS has no get_component_type on structures built with cl_abap_structdescr=>create; runs in ADT"
      },
      {
        "object": "ZCL_DA_VARIANTS",
        "class": "LTC_VARIANTS",
        "method": "GIVEN_DATA_EL_THEN_TYPED",
        "note": "open-abap RTTS has no get_component_type on structures built with cl_abap_structdescr=>create; runs in ADT"
      },
      {
        "object": "ZCL_DA_VARIANTS",
        "class": "LTC_VARIANTS",
        "method": "GIVEN_BAD_TABLE_THEN_ERROR",
        "note": "open-abap has no repository, cl_abap_dyn_prg=>check_table_name_str accepts every name; runs in ADT"
      },
      {
        "object": "ZCL_DA_VARIANTS",
        "class": "LTC_VARIANTS",
        "method": "GIVEN_FOREIGN_PACK_THEN_ERROR",
        "note": "open-abap has no repository, cl_abap_dyn_prg=>check_table_name_str accepts every name; runs in ADT"
      },
      {
        "object": "ZCL_DA_VARIANTS",
        "class": "LTC_DEFECTS",
        "method": "GIVEN_LATE_MAP_EL_THEN_TYPED",
        "note": "open-abap RTTS has no get_component_type on structures built with cl_abap_structdescr=>create; runs in ADT"
      },
      {
        "object": "ZCL_DA_VARIANTS",
        "class": "LTC_VALUE_TYPES",
        "method": "GIVEN_VALID_DATE_THEN_KEPT",
        "note": "data element DATUM is not part of the open-abap DDIC; runs in ADT"
      }
    ]
  }
}