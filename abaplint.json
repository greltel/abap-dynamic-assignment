{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2302-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "."
  },
  "rules": {
    "check_syntax": true,
    "exporting": true,
    "unused_variables": {
      "exclude": [
        "zbp_.*"
      ]
    },
    "unused_types": true,
    "unused_methods": {
      "exclude": [
        "zbp_.*"
      ]
    },
    "local_class_naming": {
      "severity": "Error",
      "patternKind": "required",
      "local": "^L.+$",
      "exception": "^LCX_.+$",
      "test": "^LT[CDH]_.+$"
    },
    "method_parameter_names": false,
    "object_naming": {
      "severity": "Error",
      "patternKind": "required",
      "clas": "^Z(C[LX]|BP)",
      "intf": "^ZIF",
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z"
    },
    "types_naming": {
      "severity": "Error",
      "pattern": "^TY_.+$"
    },
    "line_length": {
      "length": 120
    },
    "max_one_statement": true,
    "prefer_inline": true,
    "prefer_is_not": true,
    "prefer_xsdbool": true,
    "use_new": true,
    "sql_escape_host_variables": true,
    "avoid_use": {
      "defaultKey": true,
      "break": true,
      "statics": true,
      "describeLines": true
    },
    "identical_conditions": true,
    "method_length": {
      "statements": 40
    },
    "cyclomatic_complexity": {
      "max": 12
    }
  }
}